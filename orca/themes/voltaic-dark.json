{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#09090b",
    "--editor-surface": "#0c0a09",
    "--foreground": "#d4d4d8",
    "--card": "#18181b",
    "--card-foreground": "#d4d4d8",
    "--popover": "#18181b",
    "--popover-foreground": "#d4d4d8",
    "--primary": "#c8ff00",
    "--primary-foreground": "#0c0a09",
    "--secondary": "#27272a",
    "--secondary-foreground": "#d4d4d8",
    "--muted": "#27272a",
    "--muted-foreground": "#a1a1aa",
    "--accent": "#27272a",
    "--accent-foreground": "#d4d4d8",
    "--border": "#27272a",
    "--input": "#3f3f46",
    "--ring": "#c8ff00",
    "--chart-1": "#7aa2f7",
    "--chart-2": "#73daca",
    "--chart-3": "#b9a58c",
    "--chart-4": "#89ddff",
    "--chart-5": "#d4bff0",
    "--sidebar": "#18181b",
    "--sidebar-foreground": "#d4d4d8",
    "--sidebar-accent": "#27272a",
    "--sidebar-accent-foreground": "#d4d4d8",
    "--sidebar-border": "#27272a",
    "--worktree-sidebar": "#18181b",
    "--worktree-sidebar-active": "#c8ff0033",
    "--worktree-sidebar-active-border": "#c8ff00",
    "--tab-bar": "#09090b",
    "--tab-active": "#0c0a09",
    "--tab-active-foreground": "#fafafa",
    "--tab-active-indicator": "#c8ff00",
    "--tab-inactive": "#09090b",
    "--tab-inactive-foreground": "#a1a1aa",
    "--split-divider": "#27272a",
    "--split-divider-hover": "#c8ff00",
    "--chat-inline-code-foreground": "#e0af68",
    "--text-link": "#7aa2f7",
    "--editor-selection": "#c8ff0033",
    "--diff-added": "#10b981",
    "--diff-removed": "#f7768e",
    "--git-decoration-added": "#10b981",
    "--git-decoration-modified": "#e0af68",
    "--git-decoration-deleted": "#f7768e",
    "--git-decoration-renamed": "#e0af68",
    "--git-decoration-untracked": "#10b981",
    "--git-decoration-copied": "#10b981",
    "--git-decoration-ignored": "#787881"
  },
  "tokenColors": [
    {
      "name": "Variables and plain text",
      "scope": [
        "text",
        "source",
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "punctuation.definition.variable",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#d4d4d8"
      }
    },
    {
      "name": "Punctuation and delimiters",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#787881"
      }
    },
    {
      "name": "Brackets and braces",
      "scope": [
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.array",
        "punctuation.section",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly"
      ],
      "settings": {
        "foreground": "#a1a1aa"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.block.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#787881",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation tags",
      "scope": [
        "punctuation.definition.block.tag.jsdoc"
      ],
      "settings": {
        "foreground": "#a1a1aa",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.heredoc",
        "punctuation.definition.string",
        "string.quoted.other.lt-gt.include"
      ],
      "settings": {
        "foreground": "#10b981"
      }
    },
    {
      "name": "Escape sequences",
      "scope": [
        "constant.character.escape",
        "constant.character.entity",
        "punctuation.definition.entity"
      ],
      "settings": {
        "foreground": "#f7768e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Template interpolation punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#f7768e"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp",
        "keyword.operator.or.regexp",
        "keyword.control.anchor.regexp",
        "keyword.other.back-reference.regexp"
      ],
      "settings": {
        "foreground": "#e0af68"
      }
    },
    {
      "name": "Regex groups and character classes",
      "scope": [
        "punctuation.definition.group.regexp",
        "punctuation.definition.character-class.regexp"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "keyword.other.unit.user-defined",
        "keyword.other.unit.suffix.floating-point"
      ],
      "settings": {
        "foreground": "#f7768e"
      }
    },
    {
      "name": "Booleans and language constants",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#f7768e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Constants and enum members",
      "scope": [
        "constant.other",
        "variable.other.constant",
        "entity.name.constant",
        "support.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#e0af68"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.word",
        "keyword.operator.new",
        "keyword.operator.expression",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#c8ff00"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.ternary",
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "entity.name.function.call",
        "entity.name.function.member",
        "meta.function-call.method",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7aa2f7"
      }
    },
    {
      "name": "Types, classes and constructors",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.type.parameter",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "meta.type",
        "meta.type-alias",
        "meta.function-call.constructor"
      ],
      "settings": {
        "foreground": "#2ac3de"
      }
    },
    {
      "name": "Object properties and config keys",
      "scope": [
        "support.type.property-name",
        "support.type.vendored.property-name",
        "meta.object-literal.key",
        "meta.property.object",
        "variable.other.property",
        "variable.other.object.property",
        "entity.name.tag.yaml",
        "variable.key.toml"
      ],
      "settings": {
        "foreground": "#7aa2f7"
      }
    },
    {
      "name": "Struct fields and members",
      "scope": [
        "variable.other.member",
        "variable.other.field",
        "entity.name.variable.field"
      ],
      "settings": {
        "foreground": "#b9a58c"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "meta.function.parameters"
      ],
      "settings": {
        "foreground": "#d4d4d8"
      }
    },
    {
      "name": "Builtin and special variables",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super",
        "support.variable",
        "variable.parameter.function.language.special"
      ],
      "settings": {
        "foreground": "#f7768e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package",
        "entity.name.import",
        "entity.name.section",
        "entity.name.type.namespace",
        "entity.name.type.module",
        "entity.other.attribute-name.table.toml"
      ],
      "settings": {
        "foreground": "#10b981"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#f7768e"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#e0af68",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Annotations, decorators and macros",
      "scope": [
        "meta.annotation",
        "meta.attribute",
        "meta.decorator",
        "meta.function.decorator",
        "entity.name.function.decorator",
        "entity.name.function.macro",
        "punctuation.decorator",
        "punctuation.definition.annotation",
        "punctuation.definition.attribute",
        "punctuation.definition.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#bb9af7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Preprocessor directives",
      "scope": [
        "keyword.control.directive",
        "punctuation.definition.directive",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#bb9af7"
      }
    },
    {
      "name": "CSS pseudo-classes and elements",
      "scope": [
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#c8ff00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#10b981",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong emphasis",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e0af68",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#787881",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown link text",
      "scope": [
        "string.other.link.title",
        "string.other.link.description"
      ],
      "settings": {
        "foreground": "#7aa2f7"
      }
    },
    {
      "name": "Markdown link URL",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#2ac3de",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Inline code and literals",
      "scope": [
        "markup.inline.raw",
        "text.literal",
        "fenced_code.block.language"
      ],
      "settings": {
        "foreground": "#e0af68"
      }
    },
    {
      "name": "Code blocks",
      "scope": [
        "markup.fenced_code",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#d4d4d8"
      }
    },
    {
      "name": "List markers",
      "scope": [
        "punctuation.definition.list.begin"
      ],
      "settings": {
        "foreground": "#f7768e"
      }
    },
    {
      "name": "Block quotes",
      "scope": [
        "markup.quote",
        "punctuation.definition.quote.begin"
      ],
      "settings": {
        "foreground": "#787881",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Horizontal rules",
      "scope": [
        "meta.separator"
      ],
      "settings": {
        "foreground": "#787881"
      }
    },
    {
      "name": "Diff header",
      "scope": [
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#7aa2f7"
      }
    },
    {
      "name": "Diff added",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#10b981"
      }
    },
    {
      "name": "Diff removed",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#f7768e"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#e0af68"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f7768e",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#e0af68",
        "fontStyle": "strikethrough"
      }
    }
  ]
}
