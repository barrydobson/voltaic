  "tokenColors": [
    {
      "name": "Variables and plain text",
      "scope": [
        "text",
        "source",
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "punctuation.definition.variable",
        "meta.template.expression",
        "string.template variable",
        "string variable"
      ],
      "settings": {
        "foreground": "#d4d4d8"
      }
    },
    {
      "name": "Punctuation and delimiters",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#787881"
      }
    },
    {
      "name": "Brackets and braces",
      "scope": [
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.array",
        "punctuation.section",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly"
      ],
      "settings": {
        "foreground": "#a1a1aa"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.block.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#787881",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation tags",
      "scope": [
        "comment.block.documentation storage.type.class.jsdoc",
        "comment.block.documentation entity.name.type.instance.jsdoc",
        "comment.block.documentation variable.other.jsdoc",
        "punctuation.definition.block.tag.jsdoc"
      ],
      "settings": {
        "foreground": "#a1a1aa",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.heredoc",
        "punctuation.definition.string",
        "string.quoted.other.lt-gt.include"
      ],
      "settings": {
        "foreground": "#10b981"
      }
    },
    {
      "name": "Escape sequences",
